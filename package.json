{
  "name": "@dotmh/ts-base",
  "version": "1.0.0",
  "description": "The basic typescript project setup for DotMH",
  "main": "index.js",
  "type": "module",
  "prettier": "@dotmh/prettier-config",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "prepare": "husky",
    "build": "pnpm -r run build",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:check": "eslint . --fix-dry-run",
    "lint:secrets": "secretlint \"**/*\"",
    "githook:prepush": "pnpm run lint:secrets && pnpm run lint:check && pnpm run format:check && pnpm run test",
    "githook:precommit": "pnpm run lint:secrets"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dotmh/eslint-config-ts": "^3.0.1",
    "@dotmh/prettier-config": "^2.0.0",
    "@dotmh/tsconfig": "^2.1.2",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "secretlint": "^14.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=12.21.0"
  },
  "dependencies": {
    "@dotmh/ts-base": "link:"
  },
  "packageManager": "pnpm@12.21.0"
}
